# -----------------------------------------------------------------------------
# Terraform
# -----------------------------------------------------------------------------
# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version 
# control as they are data points which are potentially sensitive and also 
# specific to a single user or environment.
*.tfvars
*.tfvars.json
# Fase 7.1 — permitir tfvars de ejemplo por env (no contienen secretos)
!terraform/environments/*.tfvars
!terraform/terraform.tfvars.example

# Ignore override files as they are usually used for local non-committed changes
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files for the CI/CD if needed (optional)
# !cicd_override.tf

# Ignore CLI configuration files
.terraformrc
terraform.rc


# -----------------------------------------------------------------------------
# Node.js
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
dist/
build/


# -----------------------------------------------------------------------------
# Plan local — no commitear (roadmap privado de elevación del proyecto)
# -----------------------------------------------------------------------------
PLAN_ELEVACION_11_FASES.md
PLAN_*.md
_ROADMAP*.md

# -----------------------------------------------------------------------------
# OS/IDE
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.bak
*~
.vstoken

# -----------------------------------------------------------------------------
# Fase 6 — CI caches & artifacts (no commitear)
# -----------------------------------------------------------------------------
.eslintcache
.prettiercache
coverage/
.nyc_output/
junit.xml
checkov.sarif
trivy-*.sarif
.tflint.hcl.lock.hcl
terraform/.tflint.hcl.lock.hcl
plan.txt
tfplan
terraform/tfplan
terraform/plan.txt
terraform/checkov.sarif
terraform/.terraform/
