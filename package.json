{
  "private": true,
  "name": "erp-pipeline-root",
  "version": "1.0.0",
  "description": "Root workspace for ERP Pipeline — shared lint/format. See services/*/package.json",
  "workspaces": [
    "services/*",
    "migrations",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,yml,yaml}\"",
    "dev": "docker compose up --build",
    "dev:detached": "docker compose up --build -d",
    "test": "npm run test --workspaces --if-present",
    "clean": "docker compose down -v --remove-orphans",
    "release": "semantic-release",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.1.3",
    "@semantic-release/npm": "^11.0.1",
    "@semantic-release/release-notes-generator": "^13.0.0",
    "conventional-changelog-cli": "^4.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.3.3",
    "semantic-release": "^23.0.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
