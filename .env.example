# SPDX-License-Identifier: MIT
# .env.example — variables para docker compose local
# Copiar a .env y ajustar si se necesita: cp .env.example .env

# Postgres local (compose)
POSTGRES_DB=erpdb
POSTGRES_USER=erpadmin
POSTGRES_PASSWORD=test_password
DATABASE_URL=postgresql://erpadmin:test_password@postgres:5432/erpdb

# Servicios
NODE_ENV=development
APP_VERSION=dev
PORT_PRODUCTOS=3001
PORT_ORDENES=3002
PORT_STOCK=3003

# Nginx (local override usa nginx.local.conf con upstreams por nombre de servicio)
NGINX_PORT=80

# Fase 10 — Scale toggles (local)
REDIS_URL=redis://redis:6379
REDIS_PORT=6379
CACHE_TTL=30
CACHE_ENABLED=true
PRODUCTOS_URL=http://productos:3001
SQS_QUEUE_URL=
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_TIMEOUT_MS=10000
ENABLE_SERVICE_DISCOVERY=false

# Compose project name (evita colisiones si hay múltiples clones)
COMPOSE_PROJECT_NAME=erp-pipeline
